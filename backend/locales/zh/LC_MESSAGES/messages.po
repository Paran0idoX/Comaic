msgid "reference.auto.text_only_no_face"
msgstr "还没有已确认的脸部参考图，本轮仅使用文字生成。"

msgid "image_spec.continuity_timeout"
msgstr "连续性提取超过 {seconds} 秒总时限，已停止本次编译，请重试。"

msgid "reference.size_invalid"
