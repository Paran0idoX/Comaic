msgid "reference.input.capacity_exceeded"
msgstr "参考图数量超过工具可接收的上限，请减少输入或更换工具。"

msgid "reference.input.canvas_required"
msgstr "该工具需要明确的编辑原图，请先选择原图。"

msgid "reference.input.file_unavailable"
msgstr "参考图原文件不可用，请重新上传或选择其它图片。"

msgid "reference.input.file_changed"
msgstr "图片原文件已改变，请重新确认图片后创建新任务。"

msgid "reference.input.configuration_invalid"
msgstr "工具的参考图输入配置不完整，请检查工具设置。"

msgid "reference.auto.text_only_tool"
