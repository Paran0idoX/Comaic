msgid "script.scene_required"
msgstr "请选择本页关联的场景。"

msgid "script.scene_binding_invalid"
msgstr "请选择当前项目、脚本批次中的有效场景。"

msgid "script.character_binding_invalid"
msgstr "请选择当前分段中的有效人物，不能重复选择。"

msgid "script.edit_running"
