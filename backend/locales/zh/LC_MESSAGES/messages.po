msgid "reference.subject_invalid"
msgstr "请填写有效的素材名称和标识。"

msgid "reference.subject_key_exists"
msgstr "该素材标识已存在，请使用另一个标识。"

msgid "reference.scene_not_found"
msgstr "脚本场景不存在。"

msgid "reference.owner_invalid"
msgstr "素材归属不存在或与当前项目、类型不一致。"

msgid "reference.outfit_invalid"
msgstr "请选择当前人物未归档的造型。"

msgid "reference.roles_invalid"
msgstr "请选择当前类型下有效且不重复的参考图类别。"

msgid "reference.sources_invalid"
msgstr "输入参考图必须为当前项目已确认的素材。"

msgid "reference.prompts_invalid"
