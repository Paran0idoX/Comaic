msgstr "当前批次没有覆盖全部页面的完整候选轨道。"

msgid "consistency.character_binding_missing"
msgstr "页面角色无法回溯到大纲角色。"

msgid "consistency.characters_missing"
msgstr "脚本任务没有结构化角色绑定。"

msgid "consistency.reference_missing"
msgstr "出场角色缺少已批准的本地身份参考图。"

msgid "consistency.generated_file_missing"
msgstr "候选轨道中的本地图片不存在。"

msgid "consistency.reference_file_missing"
msgstr "角色参考图片不存在。"

msgid "consistency.generated_hash_mismatch"
msgstr "候选图片内容已发生变化。"

msgid "consistency.reference_hash_mismatch"
msgstr "角色参考图片内容已发生变化。"

msgid "consistency.task_not_found"
msgstr "一致性评估任务不存在。"

msgid "consistency.track_not_found"
msgstr "一致性候选轨道不存在。"

msgid "consistency.track_not_passed"
msgstr "只有已通过的一致性候选轨道可以采用。"

msgid "consistency.result_stale"
msgstr "一致性结果已过期，请重新评估。"

msgid "consistency.comfyui_busy_timeout"
msgstr "等待 ComfyUI 队列空闲超时。"

msgid "consistency.evaluation_failed"
msgstr "ViStoryBench 一致性评估失败。"

msgid "consistency.worker_result_missing"
msgstr "评测进程没有返回该候选轨道的结果。"

msgid "consistency.runtime_interrupted"
msgstr "服务重启导致一致性评估中断，请重新提交。"

msgid "character_reference.character_not_found"
