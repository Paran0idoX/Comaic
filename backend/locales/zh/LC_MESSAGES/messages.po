msgid "common.internal_error"
msgstr "服务暂时不可用，请稍后再试。"

msgid "image_generation.batch_not_found"
msgstr "图片生成批次不存在。"

msgid "image_generation.batch_busy"
msgstr "当前批次仍在处理页面，请等待当前页面完成后再继续。"

msgid "image_generation.batch_recovery_unavailable"
msgstr "无法确认原生图请求的状态，已保留原请求。请检查生图服务与历史记录后再继续。"

msgid "image_generation.batch_recovery_unsupported"
msgstr "当前生图服务不支持查询已提交请求，无法安全自动续跑。请先核对原请求的结果。"

msgid "image_generation.batch_configuration_mismatch"
msgstr "继续生成时不能修改原批次的工具、模式、Seed 策略或候选数。"

msgid "consistency.runtime_not_ready"
msgstr "ViStoryBench 依赖、权重或 CUDA 尚未就绪。"

msgid "consistency.threshold_invalid"
msgstr "一致性准出阈值不合法。"

msgid "consistency.batch_not_found"
msgstr "图片生成批次不存在。"

msgid "consistency.batch_legacy"
msgstr "旧版生成记录没有可靠轨道关系，请重新生成 FINAL 批次。"

msgid "consistency.final_required"
msgstr "只有 FINAL 图片生成批次可以进行准出评估。"

msgid "consistency.batch_not_complete"
msgstr "图片生成批次尚未完成。"

msgid "consistency.script_task_not_found"
msgstr "脚本任务不存在。"

msgid "consistency.script_pages_incomplete"
msgstr "脚本任务页面不完整。"

